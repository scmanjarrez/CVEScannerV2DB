CREATE UNIQUE INDEX uq_multiaffected_bounds ON multiaffected (cve_id, product_id, coalesce("versionStartIncluding", ''), coalesce("versionStartExcluding", ''), coalesce("versionEndIncluding", ''), coalesce("versionEndExcluding", ''));
CREATE VIEW product_aliases AS
SELECT old_vendor, old_product, new_vendor, new_product
FROM aliases
GROUP BY old_vendor, old_product, new_vendor, new_product
HAVING COUNT(*) * 2 >= (
    SELECT COUNT(*) FROM products
    WHERE products.vendor = aliases.old_vendor
      AND products.product = aliases.old_product
);
COMMIT;
