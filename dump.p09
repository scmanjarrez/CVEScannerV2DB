	old_vendor VARCHAR NOT NULL, 
	old_product VARCHAR NOT NULL, 
	old_version VARCHAR NOT NULL, 
	old_update VARCHAR NOT NULL, 
	new_vendor VARCHAR NOT NULL, 
	new_product VARCHAR NOT NULL, 
	PRIMARY KEY (old_vendor, old_product, old_version, old_update, new_vendor, new_product)
);
